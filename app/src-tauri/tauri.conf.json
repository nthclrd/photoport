{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoPort",
  "version": "0.1.0",
  "identifier": "app.photoport.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhotoPort",
        "width": 1080,
        "height": 860,
        "minWidth": 640,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: thumb: http://thumb.localhost media: http://media.localhost; media-src 'self' media: http://media.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "publisher": "PhotoPort contributors",
    "copyright": "MIT License",
    "shortDescription": "iPhone photo transfer over USB",
    "longDescription": "Fast, reliable iPhone photo and video transfer over USB. No iTunes, no iCloud, no app on the iPhone.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["fr-FR", "en-US"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["usbmuxd"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
